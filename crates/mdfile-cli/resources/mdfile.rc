/* Keep this file 7-bit ASCII: windres and rc.exe disagree about encodings.
   build.rs swaps the icon token below for an absolute path before compiling, so
   neither tool has to guess what a relative path is relative to. */
#include <windows.h>

1 ICON "@MDFILE_ICON@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName",    "mdfile"
            VALUE "FileDescription", "MD file assistant - headless core front end"
            VALUE "FileVersion",     "0.1.0.0"
            VALUE "InternalName",    "mdfile-cli"
            VALUE "LegalCopyright",  "MIT"
            VALUE "OriginalFilename","mdfile-cli.exe"
            VALUE "ProductName",     "MD file assistant"
            VALUE "ProductVersion",  "0.1.0.0"
            VALUE "Comments",        "engine 0.1.0 / content-immutable"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 0x04b0
    END
END
