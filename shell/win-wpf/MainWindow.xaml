<Window x:Class="MdFileAssistant.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MD文档阅读助手" Height="800" Width="1240" MinHeight="560" MinWidth="900"
        Background="{StaticResource Paper}" AllowDrop="True"
        Drop="OnDrop" DragOver="OnDragOver" UseLayoutRounding="True">
    <DockPanel>
        <!-- 顶栏：只有「怎么读」相关的动作，没有任何改内容的入口 -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="14,10">
            <DockPanel LastChildFill="False">
                <Button x:Name="BtnOpen" Content="打开 .md…" Click="OnOpen" FontWeight="SemiBold"/>
                <Button x:Name="BtnSave" Content="另存为优化版…" Click="OnSave" IsEnabled="False"/>
                <Separator DockPanel.Dock="Left" Width="10"/>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                    <TextBlock Text="预设" Style="{StaticResource Cap}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="CmbPreset" Width="112" VerticalAlignment="Center" SelectionChanged="OnPresetChanged"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                    <TextBlock Text="语法符号" Style="{StaticResource Cap}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <RadioButton x:Name="MRaw" Content="原样" GroupName="rm" VerticalAlignment="Center" Margin="0,0,8,0" Checked="OnModeChanged"/>
                    <RadioButton x:Name="MDim" Content="弱化" GroupName="rm" VerticalAlignment="Center" Margin="0,0,8,0" Checked="OnModeChanged"/>
                    <RadioButton x:Name="MHide" Content="隐藏" GroupName="rm" IsChecked="True" VerticalAlignment="Center" Checked="OnModeChanged"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                    <TextBlock Text="字号" Style="{StaticResource Cap}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="CmbType" Width="82" VerticalAlignment="Center" SelectionChanged="OnTypeChanged"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                    <RadioButton x:Name="VCompare" Content="对比源文件" GroupName="vw" IsChecked="True" VerticalAlignment="Center" Margin="0,0,8,0" Checked="OnViewChanged"/>
                    <RadioButton x:Name="VFocus" Content="专心读" GroupName="vw" VerticalAlignment="Center" Checked="OnViewChanged"/>
                </StackPanel>
                <Button x:Name="BtnAssoc" Content="设为 .md 打开方式…" DockPanel.Dock="Right" Click="OnAssoc"/>
                <TextBlock x:Name="LblFile" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Text="未打开文件" Margin="0,0,10,0"/>
            </DockPanel>
        </Border>

        <!-- 状态条：把「正文没变」这件事摆在明面上 -->
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="14,7">
            <TextBlock x:Name="LblStatus" FontSize="12.5" Foreground="#3B4048" TextWrapping="Wrap"
                       Text="打开一份 .md 开始。核心引擎：mdcore_ffi.dll（本程序不做任何排版判断）。"/>
        </Border>

        <Grid Margin="14,12,14,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="212"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ColSrc" Width="0.85*"/>
                <ColumnDefinition x:Name="ColGap" Width="12"/>
                <ColumnDefinition Width="1.15*"/>
            </Grid.ColumnDefinitions>

            <!-- 左：文件本身。等宽、不折行、不隐藏，就是那份字节 -->
            <Border x:Name="PaneSrc" Grid.Row="0" Grid.Column="0" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#F7F9FB" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="10,6">
                        <DockPanel>
                            <TextBlock Text="源文件（只读，永不写回）" FontWeight="SemiBold" FontSize="12.5"/>
                            <TextBlock x:Name="LblSrcMeta" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" FontSize="12"/>
                        </DockPanel>
                    </Border>
                    <TextBox x:Name="ViewSrc" IsReadOnly="True" BorderThickness="0" Background="White"
                             FontFamily="Consolas, Cascadia Mono, Courier New" FontSize="12.5" Foreground="#4B535C"
                             Padding="10,8,10,8" TextWrapping="NoWrap" AcceptsReturn="True" AcceptsTab="True"
                             IsUndoEnabled="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             SelectionBrush="#BFD8EA" AutomationProperties.Name="源文件视图"/>
                </DockPanel>
            </Border>

            <GridSplitter x:Name="Splitter" Grid.Row="0" Grid.Column="1" Width="12" Background="Transparent" HorizontalAlignment="Center"/>

            <!-- 右：阅读视图。版式只存在于屏幕上 -->
            <Border x:Name="PaneOut" Grid.Row="0" Grid.Column="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#F1F7F4" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="10,6">
                        <DockPanel>
                            <TextBlock x:Name="LblOutTitle" Text="优化后的读法" FontWeight="SemiBold" FontSize="12.5" Foreground="#14532D"/>
                            <TextBlock x:Name="LblOutMeta" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" FontSize="12"/>
                        </DockPanel>
                    </Border>
                    <FlowDocumentScrollViewer x:Name="ViewOut" IsToolBarVisible="False" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Auto" SelectionBrush="#BFD8EA"
                                              AutomationProperties.Name="阅读视图"/>
                </DockPanel>
            </Border>

            <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,12,0,0" Background="White"
                    BorderBrush="{StaticResource Line}" BorderThickness="1">
                <TabControl BorderThickness="0" Background="White">
                    <TabItem Header="改动清单（可逐条接受 / 拒绝）">
                        <DataGrid x:Name="GridRules" AutoGenerateColumns="False" HeadersVisibility="Column"
                                  CanUserAddRows="False" IsReadOnly="False" GridLinesVisibility="Horizontal"
                                  BorderThickness="0" RowHeight="26" FontSize="12.5">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="接受" Binding="{Binding Accept, UpdateSourceTrigger=PropertyChanged}" Width="52"/>
                                <DataGridTextColumn Header="规则" Binding="{Binding RuleName, Mode=OneWay}" Width="130" IsReadOnly="True"/>
                                <DataGridTextColumn Header="类别" Binding="{Binding Scope, Mode=OneWay}" Width="92" IsReadOnly="True"/>
                                <DataGridTextColumn Header="处数" Binding="{Binding Edits, Mode=OneWay}" Width="56" IsReadOnly="True"/>
                                <DataGridTextColumn Header="做了什么" Binding="{Binding Reason, Mode=OneWay}" Width="*"/>
                                <DataGridTextColumn Header="未生效原因" Binding="{Binding Rejected, Mode=OneWay}" Width="200" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="读法体检">
                        <Grid Margin="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel x:Name="PanelScores"/>
                            <ListBox x:Name="ListFindings" Grid.Column="1" Margin="16,0,0,0" BorderBrush="{StaticResource Line}" FontSize="12.5"/>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </DockPanel>
</Window>
