<Window x:Class="MdFileAssistant.Shell.EditWarningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="开启编辑之前" Width="880" Height="790" MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBg}" UseLayoutRounding="True">
    <Grid Margin="34,28,34,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 一句话结论，字号刻意大到不用凑近看 -->
        <StackPanel Grid.Row="0">
            <Border Background="{DynamicResource WarnBg}" BorderBrush="{DynamicResource WarnLine}"
                    BorderThickness="2" Padding="22,18">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="!" FontSize="46" FontWeight="Bold" Foreground="{DynamicResource WarnInk}"
                               VerticalAlignment="Center" Margin="0,0,18,0" Width="34" TextAlignment="Center"/>
                    <TextBlock x:Name="LblHead" FontSize="30" FontWeight="Bold"
                               Foreground="{DynamicResource WarnInk}" TextWrapping="Wrap" MaxWidth="680"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
            <TextBlock x:Name="LblLead" Margin="2,22,0,0" FontSize="21" LineHeight="32" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextPrimary}"/>
            <TextBlock Margin="2,14,0,0" FontSize="19" LineHeight="30" TextWrapping="Wrap"
                       Foreground="{DynamicResource StatusFg}"><Run Text="这个软件平时只做一件事：把同一份内容换个人能读的排法显示出来，一个字节都不写回去。编辑是唯一的例外，所以它要你亲手开，而且每次启动都是关着的。"/></TextBlock>
        </StackPanel>

        <!-- 会怎样、不会怎样 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,18,0,0">
            <StackPanel>
                <TextBlock FontSize="18" FontWeight="Bold" Foreground="{DynamicResource WarnInk}"
                           Margin="0,0,0,10" Text="开启之后："/>
                <TextBlock x:Name="LblSaveBullet" Margin="14,0,0,11" FontSize="18" LineHeight="27" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock x:Name="LblOverwriteBullet" Margin="14,0,0,11" FontSize="18" LineHeight="27" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock x:Name="LblArc" Margin="14,0,0,11" FontSize="18" LineHeight="27" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextPrimary}"
                           Text="· 开着编辑时会定时把当前内容写一份到缓存目录（本地应用数据下的 MdFileAssistant\autosave），关软件、崩溃都找得回来。间隔、目录、留几份都在「设置」里。"/>
                <TextBlock Margin="14,0,0,11" FontSize="18" LineHeight="27" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextPrimary}"
                           Text="· 写回按原编码：UTF-8 / UTF-16 / GBK / GB18030 都不转码；那个编码装不下的字，宁可拒绝写也不会换成问号。"/>
                <TextBlock x:Name="LblConflictBullet" Margin="14,0,0,11" FontSize="18" LineHeight="27" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock Margin="14,0,0,0" FontSize="18" LineHeight="27" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextPrimary}"
                           Text="· 换行风格与 BOM 保持原样，不会因为「保存」这两个字顺手把整份文件的行尾重写一遍。"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2">
            <Separator Margin="0,0,0,14" Background="{DynamicResource PanelLine}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnCancel" Content="取消，继续只读" FontSize="20" Padding="24,12"
                        IsDefault="True" IsCancel="True" Click="OnCancel"/>
                <Button x:Name="BtnGo" Content="我了解，开始编辑" FontSize="20" Padding="24,12" Margin="14,0,0,0"
                        FontWeight="Bold" Foreground="{DynamicResource WarnInk}" Click="OnGo"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
