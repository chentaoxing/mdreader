<Application x:Class="MdFileAssistant.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="Ink" Color="#0B3B5C"/>
        <SolidColorBrush x:Key="Paper" Color="#FBFBFD"/>
        <SolidColorBrush x:Key="Line" Color="#E2E6EC"/>
        <SolidColorBrush x:Key="Muted" Color="#8A9099"/>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="Cap">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>
    </Application.Resources>
</Application>
